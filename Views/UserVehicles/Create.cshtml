@model Carzi.Models.Vehicle

@{
    Layout = "~/Views/User/_UserLayout.cshtml";
    var isCarChecked = Model?.IsCar ?? true;
}

<h3>Add Vehicle</h3>

<form asp-action="Create" method="post">

    <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" id="isCar" name="isCar" value="true" @(isCarChecked ? "checked" : "") />
        <label class="form-check-label" for="isCar">
            Adding a car? (uncheck for a motorcycle)
        </label>
    </div>

    <div class="mb-3">
        <label asp-for="Brand"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Model"></label>
        <input asp-for="Model" class="form-control" />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Year">Year of Production</label>
        <input asp-for="Year" type="number" class="form-control" />
        <span asp-validation-for="Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Engine"></label>
        <input asp-for="Engine" class="form-control" />
        <span asp-validation-for="Engine" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transmission"></label>
        <input asp-for="Transmission" class="form-control" />
        <span asp-validation-for="Transmission" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LicensePlate">License Plate</label>
        <input asp-for="LicensePlate" class="form-control" />
        <span asp-validation-for="LicensePlate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FuelType">Fuel Type</label>
        <select asp-for="FuelType" class="form-select">
            <option value="">-- Select Fuel --</option>

            @foreach (var fuel in ViewBag.Fuels)
            {
                <option value="@fuel.Name">@fuel.Name</option>
            }
        </select>

        <span asp-validation-for="FuelType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConsumptionPer100Km">Fuel Consumption (L / 100km)</label>
        <input asp-for="ConsumptionPer100Km" type="number" step="0.1" class="form-control" />
        <span asp-validation-for="ConsumptionPer100Km" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Odometer"></label>
        <input asp-for="Odometer" type="number" class="form-control" />
        <span asp-validation-for="Odometer" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PurchaseDate">Purchase Date</label>
        <input asp-for="PurchaseDate" type="date" class="form-control" />
        <span asp-validation-for="PurchaseDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PurchasePrice">Purchase Price (€)</label>
        <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="PurchasePrice" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}