@model List<Carzi.Models.FuelType>

<h3>Manage Fuels</h3>

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Create" class="btn btn-success">
        + Add New Fuel
    </a>

    <form asp-action="UpdateFromApi" method="post">
        <button type="submit" class="btn btn-warning">
            Update Fuels
        </button>
    </form>

    <a href="https://fuelo.net/prices/date/2026-03-30?lang=en"
       target="_blank"
       rel="noopener noreferrer"
       class="btn btn-secondary">
        More Prices
    </a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Fuel</th>
            <th>Price (€ / liter)</th>
            <th>Updated</th>
            <th style="width:180px;">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var fuel in Model)
    {
        <tr>
            <td>@fuel.Name</td>
            <td>@fuel.PricePerLiter.ToString("F2")</td>
            <td>@fuel.UpdatedAt.ToShortDateString()</td>
            <td>
                <a asp-action="Edit" asp-route-id="@fuel.Id"
                   class="btn btn-sm btn-primary">Edit</a>

                <form asp-action="Delete" asp-route-id="@fuel.Id"
                    method="post" class="d-inline">
                    <button class="btn btn-sm btn-danger"
                            onclick="return confirm('Delete this fuel?')">
                        Delete
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
