<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>User</title>

    <!-- Page styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Carzi</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="About">About</a>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-success" asp-controller="Profile" asp-action="Index">Profile</a>
                    </li>
                    <li class="nav-item ms-2">
                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">
                            <button type="submit"
                                    class="nav-link btn btn-link text-danger p-0 pt-2">
                                Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- Main view -->
    <main class="container mt-4">

        <div class="position-relative mb-4">
            <h2 class="mb-0">Welcome, @(User.Identity?.Name ?? "User")</h2>

            <div id="alert-container" class="position-absolute top-0 end-0" style="width: 350px;">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center py-2">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center py-2">
                        @TempData["ErrorMessage"]
                    </div>
                }

            </div>
        </div>

        <ul class="nav nav-tabs mb-4">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserDashboard" ? "active" : "")"
                   asp-controller="UserDashboard" asp-action="Index">
                    Dashboard
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserVehicles" ? "active" : "")"
                   asp-controller="UserVehicles" asp-action="Index">
                    Vehicles
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserExpenses" ? "active" : "")"
                   asp-controller="UserExpenses" asp-action="Index">
                    Expenses
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "UserTrips" ? "active" : "")"
                   asp-controller="UserTrips" asp-action="Index">
                    Trips
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                   asp-controller="Home" asp-action="TripCalculator">
                    Trip Cost Calculator
                </a>
            </li>
        </ul>

        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alerts = document.querySelectorAll("#alert-container .alert");

            alerts.forEach(function (alert) {
                setTimeout(function () {

                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();

                }, 3000); // 3000ms = 3 seconds
            });

        });
    </script>
</body>
</html>