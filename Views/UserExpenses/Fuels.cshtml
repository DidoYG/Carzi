@model List<Carzi.Models.Fuel>
@{
    Layout = "~/Views/User/_UserLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-0">Fuel Expenses</h3>
        <div class="text-muted small">All fuel fill-ups for your vehicles.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <a asp-action="FuelsCreate" class="btn btn-success">+ Add Fuel</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No fuel expenses yet.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Purchase Date</th>
                <th>Vehicle</th>
                <th>Fuel</th>
                <th>Price (€ / liter)</th>
                <th>Liters</th>
                <th>Total (€)</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.Vehicle.Brand @item.Vehicle.Model (@item.Vehicle.LicensePlate)</td>
                <td>@item.FuelType.Name</td>
                <td>@item.PricePerLiter.ToString("0.00")</td>
                <td>@item.Liters.ToString("0.00")</td>
                <td>@item.TotalCost.ToString("0.00")</td>
                <td>
                    <a asp-action="FuelsEdit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="FuelsDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this fuel expense?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
