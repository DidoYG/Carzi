@model Carzi.Models.TplInsurance
@{
    Layout = "~/Views/User/_UserLayout.cshtml";
}

<h3>Add TPL Insurance Expense</h3>

<form asp-action="TplInsurancesCreate" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Vehicle</label>
        <select asp-for="VehicleId" class="form-select">
            <option value="">-- Select Vehicle --</option>
            @foreach (var v in ViewBag.Vehicles)
            {
                <option value="@v.Id">@v.Brand @v.Model (@v.LicensePlate)</option>
            }
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProviderName" class="form-label">Provider Name</label>
        <input asp-for="ProviderName" class="form-control" />
        <span asp-validation-for="ProviderName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PolicyNumber" class="form-label">Policy Number</label>
        <input asp-for="PolicyNumber" class="form-control" />
        <span asp-validation-for="PolicyNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PaymentType" class="form-label">Payment Type</label>
        <select asp-for="PaymentType" class="form-select">
            <option value="one_time">one_time</option>
            <option value="installments">installments</option>
        </select>
        <span asp-validation-for="PaymentType" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label asp-for="StartDate" class="form-label">Start Date</label>
            <input asp-for="StartDate" type="date" class="form-control" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="EndDate" class="form-label">End Date</label>
            <input asp-for="EndDate" type="date" class="form-control" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-0">
        <div class="col-12 col-md-6 mt-3">
            <label asp-for="PurchaseDate" class="form-label">Purchase Date</label>
            <input asp-for="PurchaseDate" type="date" class="form-control" />
            <span asp-validation-for="PurchaseDate" class="text-danger"></span>
        </div>
        <div class="col-12 col-md-6 mt-3">
            <label asp-for="Price" class="form-label">Price (€)</label>
            <input asp-for="Price" type="text" inputmode="decimal" class="form-control" id="tplPrice" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-success mt-3">Create</button>
    <a asp-action="TplInsurances" class="btn btn-secondary mt-3">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");
            const price = document.getElementById("tplPrice");

            if (!form || !price) return;

            form.addEventListener("submit", function () {
                if (!price.value) return;
                price.value = price.value.replace(/\s+/g, "").replace(",", ".");
            });
        });
    </script>
}
