@model Carzi.Models.Fuel
@{
    Layout = "~/Views/User/_UserLayout.cshtml";
}

<h3>Edit Fuel Expense</h3>

<form asp-action="FuelsEdit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />
    <input asp-for="FuelTypeId" type="hidden" id="fuelTypeIdInput" />

    <div class="mb-3">
        <label class="form-label">Vehicle</label>
        <select asp-for="VehicleId" class="form-select" id="vehicleSelect">
            <option value="">-- Select Vehicle --</option>

            @foreach (Carzi.Models.Vehicle v in (IEnumerable<Carzi.Models.Vehicle>)ViewBag.Vehicles)
            {
                <option value="@v.Id">
                    @v.Brand @v.Model (@v.LicensePlate)
                </option>
            }
        </select>
        <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PricePerLiter" class="form-label">
            Price (€ / liter)
            <a class="ms-2 small" href="https://fuelo.net/calendar/month/2026/03?lang=en" target="_blank" rel="noopener noreferrer">
                for old prices
            </a>
        </label>
        <input asp-for="PricePerLiter" type="number" step="0.01" class="form-control" id="priceInput" />
        <span asp-validation-for="PricePerLiter" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Liters" class="form-label">Liters</label>
        <input asp-for="Liters" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="Liters" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">Date</label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Fuels" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const vehicleSelect = document.getElementById("vehicleSelect");
            const priceInput = document.getElementById("priceInput");
            const fuelTypeIdInput = document.getElementById("fuelTypeIdInput");
            const fuelTypeNameInput = document.getElementById("fuelTypeNameInput");

            async function loadFuelInfo(overwritePrice) {
                if (!vehicleSelect) return;

                const vehicleId = vehicleSelect.value;

                if (!vehicleId) {
                    if (fuelTypeIdInput) fuelTypeIdInput.value = "";
                    if (fuelTypeNameInput) fuelTypeNameInput.value = "";
                    if (overwritePrice && priceInput) priceInput.value = "";
                    return;
                }

                try {
                    const url = '@Url.Action("VehicleFuelInfo", "UserExpenses")' + '?vehicleId=' + encodeURIComponent(vehicleId);
                    const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error("Failed to load fuel info");

                    const data = await res.json();

                    if (fuelTypeIdInput) fuelTypeIdInput.value = data.fuelTypeId ?? "";
                    if (fuelTypeNameInput) fuelTypeNameInput.value = data.fuelTypeName ?? "";

                    if (overwritePrice && priceInput) {
                        const price = Number(data.pricePerLiter);
                        if (!Number.isNaN(price)) {
                            priceInput.value = price.toFixed(2);
                        }
                    }
                } catch (e) {
                    if (fuelTypeIdInput) fuelTypeIdInput.value = "";
                    if (fuelTypeNameInput) fuelTypeNameInput.value = "";
                }
            }

            if (vehicleSelect) {
                vehicleSelect.addEventListener("change", () => loadFuelInfo(false));
            }
        });
    </script>
}

