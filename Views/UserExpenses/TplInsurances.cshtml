@model List<Carzi.Models.TplInsurance>
@{
    Layout = "~/Views/User/_UserLayout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-0">TPL Insurance Expenses</h3>
        <div class="text-muted small">Policies and validity periods.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        <a asp-action="TplInsurancesCreate" class="btn btn-success">+ Add Insurance</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No TPL insurance expenses yet.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Purchase Date</th>
                <th>Vehicle</th>
                <th>Provider</th>
                <th>Policy</th>
                <th>Start</th>
                <th>End</th>
                <th>Payment</th>
                <th>Price (€)</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PurchaseDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Vehicle.Brand @item.Vehicle.Model (@item.Vehicle.LicensePlate)</td>
                <td>@item.ProviderName</td>
                <td>@item.PolicyNumber</td>
                <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@item.PaymentType</td>
                <td>@item.Price.ToString("0.00")</td>
                <td>
                    <a asp-action="TplInsurancesEdit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                    <form asp-action="TplInsurancesDelete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-danger" onclick="return confirm('Delete this insurance expense?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
