@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .app-card {
        padding: 1.2rem;
        min-height: 160px;
        border-radius: 12px;
        border: 1px solid #adb5bd;
    }

    .app-card-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <h1 class="mb-3">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">Last updated: March 27, 2026</p>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Overview</h2>
                <p class="mb-0">
                    Carzi is a vehicle and trip management app. This policy explains what data we collect,
                    how we use it, and the choices you have.
                </p>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Data We Collect</h2>
                <ul class="mb-0">
                    <li><strong>Account data:</strong> username and email address (when you create an account).</li>
                    <li><strong>App content you provide:</strong> vehicles, trips, fuel logs, inspections, vignettes, and related notes you enter.</li>
                    <li><strong>Usage & diagnostics (limited):</strong> basic server logs (e.g., request time and errors) to keep the service running securely.</li>
                </ul>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Cookies & Authentication</h2>
                <p class="mb-0">
                    We use an authentication cookie to keep you signed in and protect access to your account.
                    If you sign out, the cookie is cleared.
                </p>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Third-Party Services</h2>
                <p class="mb-0">
                    Carzi may request fuel price data from third-party providers (for example, Fuelo).
                    These requests may expose your IP address to that provider as part of normal internet traffic.
                </p>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">How We Use Your Data</h2>
                <ul class="mb-0">
                    <li>Provide core features (dashboards, calculations, saving your vehicles and trips).</li>
                    <li>Authenticate you and protect against unauthorized access.</li>
                    <li>Maintain and improve reliability and performance.</li>
                </ul>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Sharing</h2>
                <p class="mb-0">
                    We do not sell your personal data. We only share data when required to operate the app
                    (for example, with service providers that deliver fuel price data) or when required by law.
                </p>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Retention</h2>
                <p class="mb-0">
                    We keep your account and in-app content for as long as you use Carzi, unless a longer retention
                    period is required by law or needed for security and auditing purposes.
                </p>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Your Choices</h2>
                <ul class="mb-0">
                    <li>Review and update your profile and in-app content in the app.</li>
                    <li>Sign out to end the current session.</li>
                    <li>Contact us to request access, correction, or deletion where applicable.</li>
                </ul>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Contact</h2>
                <p class="mb-0">
                    Questions about privacy? Contact the Carzi team at <a href="mailto:privacy@carzi.local">privacy@carzi.local</a>.
                </p>
            </div>
        </div>
    </div>
</div>
