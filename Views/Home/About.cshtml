@{
    ViewData["Title"] = "About";
    var version = typeof(Carzi.Controllers.HomeController).Assembly.GetName().Version?.ToString() ?? "unknown";
}

<style>
    .app-card {
        padding: 1.2rem;
        min-height: 160px;
        border-radius: 12px;
        border: 1px solid #adb5bd;
    }

    .app-card-title {
        font-size: 1.2rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <h1 class="mb-3">@ViewData["Title"]</h1>
        <p class="text-muted">Carzi v@version</p>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">What is Carzi?</h2>
                <p class="mb-0">
                    Carzi helps you keep track of your vehicles and important costs and deadlines like fuel logs,
                    trips, inspections, and vignettes, all in one place.
                </p>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Key Features</h2>
                <ul class="mb-0">
                    <li>Manage vehicles, trips, and fuel expenses.</li>
                    <li>Track inspections and vignettes.</li>
                    <li>Trip cost calculator with optional fuel price lookup.</li>
                    <li>Guest mode for quick access.</li>
                </ul>
            </div>
        </div>

        <div class="card app-card mb-3">
            <div class="card-body">
                <h2 class="h5">Get in touch</h2>
                <p class="mb-0">
                    For feedback or support, email <a href="mailto:support@carzi.local">support@carzi.local</a>.
                </p>
            </div>
        </div>
    </div>
</div>
