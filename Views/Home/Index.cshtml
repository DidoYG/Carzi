@{
    ViewData["Title"] = "Home";
    var username = User.Identity?.Name ?? "User";
}

@{
    var isUserRole = User.IsInRole("User");
    var isAdminRole = User.IsInRole("Admin");
    var isGuestRole = User.IsInRole("Guest");
}

<style>
    .home-container {
        padding: 20px;
    }

    .welcome {
        font-size: 20px;
        margin-bottom: 20px;
    }

    .tabs {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        border-bottom: 2px solid #ddd;
    }

    .tabs a {
        padding: 10px 15px;
        text-decoration: none;
        color: #333;
        font-weight: bold;
        border-bottom: 3px solid transparent;
    }

    .tabs a.active {
        border-bottom: 3px solid #007bff;
        color: #007bff;
    }

    .content-panel {
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 6px;
        min-height: 300px;
        background-color: #fff;
    }
</style>

<div class="home-container">

    <!-- Welcome Title -->
    <div class="welcome">
        <h2 class="mb-3">Welcome, Guest</h2>
    </div>

    @if (isGuestRole)
    {
        <div class="text-center mb-4">
            <h3 class="text-success mb-1"><strong>Trip Cost Calculator</strong></h3>
            <label class="mb-0">
                Estimate fuel and vignette costs for your trip
            </label>
        </div>

        <div class="content-panel">
            @await Html.PartialAsync("_GuestTripCalc")
        </div>
    }
</div>
