@model Carzi.Models.Trip
@using System.Globalization

@{
    Layout = "~/Views/User/_UserLayout.cshtml";
}

<h3>Add Trip</h3>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- Vehicle Selection -->
    <div class="mb-3">
        <label>Vehicle</label>
        <select id="vehicleSelect" asp-for="VehicleId" class="form-select">
            <option value="">-- Select Vehicle --</option>

            @foreach (var v in ViewBag.Vehicles)
            {
                <option value="@v.Id"
                        data-consumption="@v.ConsumptionPer100Km"
                        data-fuel="@v.FuelType"
                        data-fuelprice="@v.FuelPrice">
                    @v.Brand @v.Model (@v.LicensePlate)
                </option>
            }
        </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartLocation">Starting Location</label>
        <input asp-for="StartLocation" class="form-control" />
        <span asp-validation-for="StartLocation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndLocation">Destination</label>
        <input asp-for="EndLocation" class="form-control" />
        <span asp-validation-for="EndLocation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate">Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate">End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DistanceKm">Distance (km)</label>
        <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label" for="fuelPrice">
            Fuel Price (€ / liter)
            <a class="ms-2 small" href="https://fuelo.net/calendar/month/2026/03?lang=en" target="_blank" rel="noopener noreferrer">
                for old prices
            </a>
        </label>
        <input asp-for="FuelPricePerLiter" id="fuelPrice" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="FuelPricePerLiter" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsTempVignetteRequired" class="form-check-input" id="vignetteCheck" />
        <label asp-for="IsTempVignetteRequired" class="form-check-label">
            Vignette purchased for this trip?
        </label>
    </div>

    <div class="mb-3" id="vignetteCostDiv">
        <label class="form-label" for="vignetteType">Vignette Type</label>
        <select id="vignetteType" asp-for="TempVignetteCost" class="form-select">
            <option value="0">-- Select Vignette --</option>
            @foreach (var v in ViewBag.Vignettes)
            {
                <option value="@v.Price" data-days="@v.ValidityDays">
                    @v.Name (€@v.Price.ToString("0.00", CultureInfo.InvariantCulture))
                </option>
            }
        </select>
        <span asp-validation-for="TempVignetteCost" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<div id="result" class="alert alert-success d-none mt-3"></div>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const vehicleSelect = document.getElementById("vehicleSelect");
    const fuelPriceInput = document.getElementById("fuelPrice");
    const vignetteCheck = document.getElementById("vignetteCheck");
    const vignetteDiv = document.getElementById("vignetteCostDiv");
    const vignetteInput = document.getElementById("vignetteType");

    // Toggle vignette field
    function toggleVignette() {
        if (!vignetteCheck || !vignetteDiv) return;

        if (vignetteCheck.checked) {
            vignetteDiv.style.display = "block";
        } else {
            vignetteDiv.style.display = "none";

            if (vignetteInput) {
                vignetteInput.value = "0";
            }
        }
    }

    // Autofill fuel price
    function autofillFuelPrice() {
        if (!vehicleSelect || !fuelPriceInput) return;

        const selected = vehicleSelect.options[vehicleSelect.selectedIndex];

        if (!selected) return;

        const price = parseFloat(selected.dataset.fuelprice);

        if (!isNaN(price)) {
            fuelPriceInput.value = price.toFixed(2);
        }
    }

    // Events
    if (vehicleSelect) {
        vehicleSelect.addEventListener("change", autofillFuelPrice);
    }

    if (vignetteCheck) {
        vignetteCheck.addEventListener("change", toggleVignette);
    }

    // Run once on load
    toggleVignette();
    autofillFuelPrice();

});
</script>
