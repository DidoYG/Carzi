@model List<Carzi.Models.Trip>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h3 class="mb-0">My Trips</h3>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-success">+ Add Trip</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No trips yet.</div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Vehicle</th>
                <th>From</th>
                <th>To</th>
                <th>Distance (km)</th>
                <th>Total Cost (€)</th>
                <th style="width:200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var trip in Model)
        {
            <tr>
                <td>@trip.Vehicle.Brand @trip.Vehicle.Model</td>
                <td>@trip.StartLocation</td>
                <td>@trip.EndLocation</td>
                <td>@trip.DistanceKm km</td>
                <td>@trip.TotalTripCost.ToString("0.00") €</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@trip.Id"
                    class="btn btn-sm btn-primary">View</a>

                    <form asp-action="Delete" asp-route-id="@trip.Id"
                        method="post" class="d-inline">
                        <button class="btn btn-sm btn-danger"
                                onclick="return confirm('Delete this trip?')">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
