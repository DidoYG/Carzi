@model Carzi.Models.Trip

@{
    Layout = "~/Views/User/_UserLayout.cshtml";
}

<h3>View Trip</h3>
<form asp-action="Edit" method="get">
    
    <input type="hidden" asp-for="Id" />

    <!-- Vehicle Selection -->
    <div class="mb-3">
        <label>Vehicle</label>
        <select asp-for="VehicleId" class="form-select" disabled>
            <option value="">-- Select Vehicle --</option>

            @foreach (var v in ViewBag.Vehicles)
            {
                <option value="@v.Id">@v.Brand @v.Model (@v.LicensePlate)</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="StartLocation">Starting Location</label>
        <input asp-for="StartLocation" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="EndLocation">Destination</label>
        <input asp-for="EndLocation" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="StartDate">Start Date</label>
        <input asp-for="StartDate" type="date" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="EndDate">End Date</label>
        <input asp-for="EndDate" type="date" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="DistanceKm">Distance (km)</label>
        <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="FuelPricePerLiter">Fuel Price (€ / liter)</label>
        <input asp-for="FuelPricePerLiter" type="number" step="0.01" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="NeededFuel">Consumed Fuel (L)</label>
        <input asp-for="NeededFuel" type="number" step="0.1" class="form-control" readonly />
    </div>

    <div class="mb-3">
        <label asp-for="TotalFuelPrice">Total Fuel Price (€)</label>
        <input asp-for="TotalFuelPrice" type="number" step="0.1" class="form-control" readonly />
    </div>

    <div class="mb-3" id="vignetteCostDiv">
        <label asp-for="TempVignetteCost">Vignette Type</label>
        <input type="text"
               class="form-control"
               value="@(Model.IsTempVignetteRequired ? Model.TempVignetteCost.ToString("0.00") : "0.00")"
               readonly />
    </div>

    <div class="mb-3">
        <label asp-for="TotalTripCost">Total Trip Cost (€)</label>
        <input type="text" class="form-control" value="@Model.TotalTripCost.ToString("0.00")" readonly />
    </div>

    <a asp-action="Index" class="btn btn-success">Done</a>
</form>
